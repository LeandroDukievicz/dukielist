$bg: #050b16;
$surface: #071222;
$line: #24558d;
$cyan: #00e5ff;
$magenta: #ff2ec4;
$muted: #7891b8;
$text: #dbe8ff;

Screen {
    background: $bg; color: $text;
    scrollbar-background: $surface; scrollbar-color: $line; scrollbar-size: 1 1;
}
Button {
    background: #091628; color: $text; border: round $line;
    height: 3; min-width: 12; padding: 0 1;
}
Button:hover, Button:focus {
    background: #123a65; color: #ffffff; border: round $cyan; text-style: bold;
}
#main-shell { width: 100%; height: 100%; padding: 0 1; border: round $line; }
#welcome-title, #app-title {
    width: 100%; height: 2; padding: 0 1; border-bottom: solid $line;
    content-align: center middle; text-align: center;
}
#header-row { height: 7; width: 100%; align: left middle; }
#header-info {
    width: 36; height: 6; border: round $cyan; color: $cyan;
    background: $surface; content-align: center middle; text-align: center;
}
#workspace-row, #main-area { width: 1fr; height: 1fr; }
#right-rail { width: 34; height: 100%; margin-left: 1; }
#sidebar-scroll {
    height: 1fr; border: round $magenta; border-left: round $cyan;
    background: $surface; padding: 1;
}
#sidebar { height: auto; padding: 0 1; }
#view-tabs {
    width: 1fr; height: 5; margin-right: 1; padding: 0 1;
    border: round $cyan; border-right: round $magenta;
    background: $surface; align: left middle;
}
.tabs-icon { width: 3; height: 3; color: $cyan; content-align: left middle; }
.tabs-label { width: 15; height: 3; color: $magenta; text-style: bold; content-align: left middle; }
.view-tab { min-width: 11; width: 12; height: 3; margin-right: 1; padding: 0; border: none; }
.view-tab.active { border: round $cyan; background: #073653; color: $cyan; text-style: bold; }
.tab-hint { width: 1fr; height: 3; color: $magenta; content-align: right middle; text-align: right; }
#period-bar {
    height: 5; margin-top: 1; padding: 0; border: round $cyan;
    border-right: round $magenta; background: $surface; align: left middle;
}
#period-navigation { width: 1fr; min-width: 0; height: 3; align: left middle; }
#period-actions { width: auto; height: 3; align: left middle; }
.period-arrow { width: 4; min-width: 4; height: 3; padding: 0; border: none; color: $cyan; background: transparent; }
.period-title {
    width: 1fr; min-width: 0; height: 3; overflow: hidden;
    color: #9fdcff; text-style: bold; content-align: left middle;
}
.primary-action { color: $cyan; border: round $cyan; background: #09283e; }
.secondary-action { color: #b7c9e9; border: round #466da0; }
.complete-action { color: #39ff14; border: round #39ff14; }
.danger-action { color: #ff416c; border: round #ff416c; }
#views { width: 100%; height: 1fr; overflow: auto auto; }
.view-panel { display: none; width: 100%; height: 100%; }
.view-panel.active-view { display: block; }
#week-table, #month-table { display: none; }
#week-board { width: 100%; height: 100%; min-height: 12; padding: 0; }
#week-board:focus { background: #091d32; }
TaskTable {
    width: 100%; height: 100%; border: round $cyan; border-right: round $magenta;
    background: $bg; color: $text;
}
TaskTable:focus { border-left: round $magenta; }
DataTable > .datatable--header { color: $cyan; background: #09182b; text-style: bold; }
DataTable > .datatable--cursor { color: #ffffff; background: #064977; }
.empty-state {
    display: none; width: 100%; height: 100%; border: round $cyan;
    color: $muted; content-align: center middle;
}
#month-calendar { width: 100%; height: 100%; padding: 0; }
#progress-panel {
    height: 4; margin-top: 1; padding: 0 2; border: round $cyan;
    border-right: round $magenta; background: $surface;
}
#app-footer { layout: horizontal; height: 2; padding: 0 1; align: left middle; }
#command-prompt { width: 1fr; height: 1; color: $cyan; }
#status-bar { width: auto; height: 1; }
.footer-brand { width: auto; color: #91b3df; }
.footer-productivity { width: auto; margin-left: 2; }
.footer-infinity { width: 3; margin-left: 2; color: $cyan; }

/* Abaixo de 140 colunas, priorizar tarefas; ajuda continua acessível com H. */
.compact-layout #right-rail { display: none; }
.compact-layout .tab-hint { display: none; }
.narrow-layout #period-bar { height: 8; layout: vertical; }
.narrow-layout #period-navigation, .narrow-layout #period-actions { width: 100%; height: 3; }
.narrow-layout #period-actions { align: center middle; }
.narrow-layout .footer-productivity, .narrow-layout .footer-infinity { display: none; }
.short-layout #header-row { height: 4; }
.short-layout #header-info { height: 4; width: 31; }
.short-layout #view-tabs { height: 3; border: none; }
.short-layout #period-bar { margin-top: 0; }
.short-layout #progress-panel { display: none; }
.short-layout #app-footer { height: 1; }
.narrow-layout #view-tabs { padding: 0; }
.narrow-layout .tabs-icon, .narrow-layout .tabs-label { display: none; }
.narrow-layout .view-tab { min-width: 11; width: 11; margin-right: 0; }

/* O calendário usa toda a altura recuperada e sempre mostra o mês completo. */
.mode-month #progress-panel { display: none; }

/* Abertura: os cartões continuam acessíveis mesmo com pouca altura. */
#welcome-shell { width: 100%; height: 100%; padding: 0 1; }
#welcome-card {
    width: 100%; height: auto; min-height: 20; margin-top: 2;
    padding: 2 3; border: round $cyan; border-right: round $magenta;
    background: $surface; align: center middle;
}
.eyebrow { height: 1; color: $cyan; margin-bottom: 1; }
.welcome-prompt { height: 2; color: #a9bee4; text-style: bold; content-align: center middle; }
#mode-chooser { width: 100%; height: 8; align: center middle; }
.mode-card {
    width: 1fr; height: 6; margin: 0 1; padding: 1;
    border: round $line; color: #a9bee4; content-align: center middle; text-align: center;
}
.mode-card:focus, .mode-card.selected {
    background: #103252; border: round $cyan; color: #ffffff; text-style: bold;
}
.welcome-help { height: auto; color: $magenta; margin-top: 1; text-align: center; }
.welcome-meta { height: 1; color: $muted; margin-top: 1; text-align: center; }
.narrow-layout #mode-chooser { layout: vertical; height: 18; }
.narrow-layout .mode-card { width: 100%; height: 5; margin: 0 0 1 0; }
.narrow-layout #welcome-card { padding: 1; }

/* Formulários: mesma coluna de labels, sem decoração ocupando os campos. */
ModalScreen { background: rgba(1, 5, 18, 0.65); align: center middle; }
#form-overlay {
    width: 66%; max-width: 110; height: auto; max-height: 94%;
    overflow-y: auto; padding: 1 2; border: round $cyan;
    border-right: round $magenta; border-bottom: round $magenta; background: $surface;
}
.modal-heading { width: 100%; height: 3; align: left middle; }
.modal-symbol { width: 4; color: $cyan; text-style: bold; content-align: center middle; }
.modal-title { width: auto; height: 3; color: $cyan; text-style: bold; content-align: left middle; }
.modal-tagline { width: 1fr; height: 3; color: $muted; text-align: right; padding-right: 1; content-align: right middle; }
.close-button { width: 3; min-width: 3; height: 3; padding: 0; border: none; color: $magenta; }
.form-row { width: 100%; height: 3; align: left middle; }
.description-row { height: 5; }
.form-label { width: 20; height: 3; color: #9fdcff; text-style: bold; content-align: left middle; }
.field-icon { width: 3; height: 3; color: #b7c9e9; content-align: center middle; }
Input, TextArea, Select {
    width: 1fr; border: round #466da0; background: #050d1d; color: $text;
}
Input, Select { height: 3; }
TextArea { height: 5; }
SelectCurrent { height: 1; padding: 0 1; border: none; background: #050d1d; color: $text; }
SelectCurrent > #label, SelectCurrent.-has-value > #label { color: $text; background: transparent; }
SelectCurrent .arrow { color: $cyan; background: transparent; }
Input:focus, TextArea:focus, Select:focus { border: round $cyan; background: #0c2547; }
.view-radio { width: 1fr; height: 3; border: none; padding: 0; layout: horizontal; }
.view-radio > RadioButton { width: auto; margin-right: 1; border: none; background: transparent; color: $text; }
.view-radio > RadioButton.-on .toggle--button { color: $cyan; }
.modal-divider { width: 100%; height: 1; border-bottom: solid $magenta; overflow: hidden; }
.form-actions { width: 100%; height: 3; align: center middle; }
.form-actions Button { min-width: 10; margin: 0 1; padding: 0 1; }
.modal-footer-help { width: 100%; height: 2; color: $muted; content-align: center middle; text-align: center; }
.compact-layout #form-overlay { width: 94%; padding: 1; }
.compact-layout .modal-tagline { display: none; }
.narrow-layout .form-label { width: 16; }
.narrow-layout #form-overlay .form-actions { layout: vertical; height: auto; }
.narrow-layout #form-overlay .form-actions Button { width: 100%; margin: 0; }
.narrow-layout #form-overlay .modal-footer-help { height: auto; min-height: 2; }
.field-label { height: 1; color: #9fdcff; text-style: bold; }
.modal-subtitle { height: auto; color: $muted; margin-bottom: 1; }
#confirm-card, #filter-card, #help-card {
    width: 64; max-width: 96%; height: auto; max-height: 90%; overflow-y: auto;
    padding: 1 2; border: round $magenta; background: $surface;
}
.confirm-task { height: auto; border: round $line; padding: 1; margin: 1 0; text-style: bold; }
.confirm-question { height: auto; color: #b8c8e7; }
.help-copy { height: auto; margin: 1 0; }
